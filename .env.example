# Public Supabase connection (safe to expose to the browser; RLS remains required)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Server-only Supabase credentials (do not use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Single administrator. The password is used by scripts/ensure-admin.mjs only.
ADMIN_EMAIL=you@movinglondontransport.com
ADMIN_PASSWORD=choose_a_long_password
DATABASE_URL=your_supabase_pooler_connection_string
DIRECT_URL=your_supabase_direct_connection_string

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Workspace / Gmail OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must match the Authorized redirect URI on the Google OAuth client (local + later production).
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/google/callback
